# --- ocr_client_poller.py config ---------------------------------------
# วางไฟล์นี้ไว้โฟลเดอร์เดียวกับ ocr_client_poller.py, meter_reader.py,
# best.pt, data.yaml แล้ว copy ไปเป็น .env (ไม่ใช่ .env.example) พร้อมใส่
# ค่าจริง — ห้าม commit .env ตัวจริงเข้า git เด็ดขาด (มีรหัสผ่านอยู่ในนั้น)

# URL ของ image-store (เครื่องที่รัน docker compose) — ต้องเป็น URL ที่
# เครื่องนี้ (เครื่องที่รัน OCR) เข้าถึงได้จริง:
#   - อยู่วง LAN เดียวกัน        -> ใช้ IP วง LAN ของเครื่อง image-store
#   - อยู่คนละเน็ตเวิร์ก           -> ต้องมี URL สาธารณะ/tunnel/VPN ก่อน
#     (ดูรายละเอียดที่คุยกันไว้ก่อนหน้าเรื่อง "ไม่ได้อยู่วง LAN เดียวกัน")
IMAGE_STORE_BASE_URL=https://192.168.20.13:8443

# image-store ใช้ self-signed certificate (HTTPS) — ถ้ายังไม่ได้เปลี่ยนเป็น
# certificate จริง ให้ปล่อยเป็น false ไว้ (ข้ามการเช็ค cert)
IMAGE_STORE_VERIFY_TLS=false

# บัญชี "OCR service account" ที่สมัคร + promote เป็น admin ไว้แล้ว
# (ดูขั้นตอนสร้างบัญชีในคอมเมนต์บนสุดของ ocr_client_poller.py)
OCR_SERVICE_USERNAME=ocr-service
OCR_SERVICE_PASSWORD=

# เช็คงานใหม่ทุกกี่วินาที
POLL_INTERVAL_SECONDS=10

# ดึงงานมาทำครั้งละกี่ภาพต่อรอบ
BATCH_SIZE=5
